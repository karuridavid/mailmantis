# Everything here is optional for a local Docker install.
# Copy to .env and fill in what you need: cp .env.example .env

# Public HTTPS install (with `docker compose --profile https up -d`)
# DOMAIN=app.example.com
# TRUST_PROXY=1

# Keys. Generated and stored in the app-data volume on first start when left empty.
# Required on Vercel. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# APP_ENCRYPTION_KEY=
# ADMIN_SETUP_KEY=

# Google OAuth client. Can also be entered in the dashboard under Settings.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Only needed if the redirect URI cannot be worked out from the request:
# GOOGLE_REDIRECT_URI=https://app.example.com/api/google_oauth_callback
# APP_URL=https://app.example.com

# POSTGRES_PASSWORD=change-me
# PORT=8080
